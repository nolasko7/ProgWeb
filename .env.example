# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a git (está en el .gitignore).

PORT=3000

# Clave para firmar la cookie de sesión (poné un texto largo y aleatorio)
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Costo del hash de contraseñas con bcrypt
BCRYPT_SALT_ROUNDS=10
