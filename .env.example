# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a git (está en el .gitignore).

PORT=3000

# Clave para firmar la cookie de sesión (poné un texto largo y aleatorio)
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Costo del hash de contraseñas con bcrypt
BCRYPT_SALT_ROUNDS=10

# Clave para firmar los JWT de la API (texto largo y aleatorio, distinto al de la sesión)
JWT_SECRET=cambiar-por-otro-texto-largo-y-aleatorio

# Duración del token (ej: 15m, 2h, 1d)
JWT_EXPIRES_IN=2h

# Datos del administrador que crea "npm run crear-admin"
# Si un valor tiene # o espacios, ponelo entre comillas (si no, dotenv lo corta)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@miecommerce.com
ADMIN_PASSWORD="cambiar-esta-clave"
