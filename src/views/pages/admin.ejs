<div class="mx-4 sm:mx-12 lg:mx-32 my-6">
    <h1 class="text-4xl mb-6">Administración</h1>

    <!-- Métricas (mismo servicio que GET /api/stats) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-[0_4px_10px_rgba(0,0,0,0.10)]">
            <p class="text-sm text-gray-500">Productos</p>
            <p class="text-4xl font-semibold" id="total-productos"><%= stats.totalProducts %></p>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-[0_4px_10px_rgba(0,0,0,0.10)]">
            <p class="text-sm text-gray-500">Categorías</p>
            <p class="text-4xl font-semibold" id="total-categorias"><%= stats.totalCategories %></p>
        </div>
    </div>

    <p class="mb-4 text-sm text-gray-600">
        El alta, baja y modificación de productos y categorías se hace desde la API
        (<code>/api/products</code> y <code>/api/categories</code>) con un token de administrador.
    </p>

    <h2 class="text-2xl mb-3">Productos</h2>
    <div class="overflow-x-auto bg-white rounded-2xl shadow-[0_4px_10px_rgba(0,0,0,0.10)] mb-8">
        <table class="w-full text-sm text-left">
            <thead class="bg-gray-100 text-gray-600">
                <tr>
                    <th class="px-4 py-2">ID</th>
                    <th class="px-4 py-2">Nombre</th>
                    <th class="px-4 py-2">Categoría</th>
                    <th class="px-4 py-2 text-right">Precio</th>
                    <th class="px-4 py-2 text-right">Stock</th>
                </tr>
            </thead>
            <tbody>
                <% productos.forEach(producto => { %>
                    <tr class="border-t border-gray-100">
                        <td class="px-4 py-2"><%= producto.id %></td>
                        <td class="px-4 py-2"><a class="hover:underline" href="/product/<%= producto.id %>"><%= producto.name %></a></td>
                        <td class="px-4 py-2"><%= nombrePorId[producto.id_Category] || '-' %></td>
                        <td class="px-4 py-2 text-right">$ <%= Number(producto.price).toLocaleString() %></td>
                        <td class="px-4 py-2 text-right"><%= producto.stock %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <h2 class="text-2xl mb-3">Categorías</h2>
    <div class="flex flex-wrap gap-2 mb-10">
        <% categorias.forEach(categoria => { %>
            <span class="bg-white rounded-xl px-3 py-1.5 text-sm shadow-sm">#<%= categoria.id %> <%= categoria.name %></span>
        <% }) %>
    </div>
</div>
