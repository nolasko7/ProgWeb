<div id="carrito" data-vacio="<%= !(elementosCarrito && elementosCarrito.length > 0) %>" class="mx-4 sm:mx-12 md:mx-32 lg:mx-72">
    <div class="flex flex-col min-w-0">
        <div class="my-4 w-32">
            <a href="/" class="text-gray-700 no-underline hover:underline flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                Volver al inicio
            </a>
        </div>

        <h1 class="text-4xl min-w-0 truncate">Productos de tu carrito</h1>
    </div>

    <% if (elementosCarrito && elementosCarrito.length > 0) { %>
        <% elementosCarrito.forEach(elemento => { %>
            <%- include('../partials/CartasMuestraProductoCarrito', { elementosCarrito: elemento }) %>
        <% }) %>
    <% } else { %>
        <div class="my-8 rounded-2xl border border-dashed border-gray-300 bg-white p-6 text-center text-gray-600">
            Tu carrito está vacío.
        </div>
    <% } %>

    <div class="flex flex-col items-end">
        <div class="flex text-2xl truncate min-w-0">
            <p class="mx-3">Total de puntos</p>
            <p>$ <%= (totalCarrito || 0).toLocaleString() %></p>
        </div>

        <div class="flex items-center">
            <% if (elementosCarrito && elementosCarrito.length > 0) { %>
                <form action="/cart/clear" method="POST" class="inline">
                    <button type="submit" class="my-2 mr-2 text-white cursor-pointer px-4 py-1.5 bg-red-500 rounded-2xl">Vaciar carrito</button>
                </form>
            <% } %>
            <button type="button" class="my-2 text-white cursor-pointer px-4 py-1.5 bg-gray-500 rounded-2xl">Ir a pagar</button>
        </div>
    </div>
</div>

<script>
    // Reemplaza únicamente el contenido del carrito con el HTML más reciente del servidor.
    // Se usa tanto después de una acción del usuario como al recibir una notificación WebSocket.
    window.actualizarVistaCarrito = async function actualizarVistaCarrito() {
        const carritoActual = document.getElementById("carrito");
        if (!carritoActual) return;

        try {
            const respuesta = await fetch("/cart/list", {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!respuesta.ok) throw new Error("No se pudo consultar el carrito");

            const html = await respuesta.text();
            reemplazarCarritoDesdeHtml(html);
        } catch (error) {
            console.error("No se pudo actualizar el carrito:", error);
        }
    };

    // Extrae del HTML recibido el carrito y el contador renderizados por Express/EJS.
    function reemplazarCarritoDesdeHtml(html) {
        const pagina = new DOMParser().parseFromString(html, "text/html");
        const carritoNuevo = pagina.getElementById("carrito");
        const carritoActual = document.getElementById("carrito");
        if (!carritoNuevo || !carritoActual) return;

        const estabaVacio = carritoActual.dataset.vacio === "true";
        carritoActual.replaceWith(carritoNuevo);

        const contadorActual = document.getElementById("contador-carrito");
        const contadorNuevo = pagina.getElementById("contador-carrito");
        if (contadorActual && contadorNuevo) {
            contadorActual.textContent = contadorNuevo.textContent;
        }

        if (!estabaVacio && carritoNuevo.dataset.vacio === "true") {
            mostrarNotificacion("Tu carrito quedó vacío");
        }
    }

    // Intercepta los formularios del carrito para actualizar la vista sin recargar la página.
    document.addEventListener("submit", async (event) => {
        const form = event.target;
        const carrito = document.getElementById("carrito");
        if (!carrito || !carrito.contains(form) || !form.getAttribute("action")) return;

        event.preventDefault();

        const respuesta = await fetch(form.action, { method: "POST" });
        if (!respuesta.ok) {
            mostrarNotificacion(await respuesta.text());
            return;
        }
        reemplazarCarritoDesdeHtml(await respuesta.text());
    });

    // Muestra avisos breves, por ejemplo cuando se vacía el carrito o no hay stock.
    function mostrarNotificacion(texto) {
        const cartel = document.createElement("div");
        cartel.textContent = texto;
        cartel.className = "cartel-agregado fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-emerald-100 border border-emerald-400 text-emerald-800 px-4 py-3 rounded-xl font-semibold shadow";
        document.body.appendChild(cartel);
        cartel.addEventListener("animationend", () => cartel.remove());
    }
</script>
