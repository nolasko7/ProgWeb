<div class = "max-w-6xl mx-auto py-8 px-4">
     
    <div class="w-full flex justify-center h-32 items-center">
        <h1 class="text-3xl font-medium text-gray-900">Categoria: <%= categoryName %></h1>
    </div>
    <div class="w-full flex justify-between items-center h-20 px-10">
        <div class="flex items-center">
            <h2 class="text-lg font-semibold text-gray-800">Lista de Productos:</h2>
        </div>
        
        <div class="sort flex items-center gap-2">
            <form action="/category/<%= categoryName %>" method="GET" class="flex items-center gap-2">
                <label for="sort-select" class="whitespace-nowrap">Ordenar por</label>
                <select id="sort-select" name="sort">
                    <option value="" <%= !sort ? 'selected' : '' %>>Predeterminado</option>
                    <option value="asc" <%= sort === 'asc' ? 'selected' : '' %>>Menor precio</option>
                    <option value="desc" <%= sort === 'desc' ? 'selected' : '' %>>Mayor precio</option>
                </select>
                <button type="submit" class="my-3 w-full text-gray-50 bg-mist-600 text-center rounded-full py-2 px-4 cursor-pointer transition-colors duration-300 hover:bg-mist-900">Aplicar</button>
            </form>
        </div>
    </div>
    <% if (productos.length > 0) { %>
        <div class="contenedor-tarjetas">
            <% productos.forEach(producto => { %>
                <%- include('../partials/productCard', {producto: producto}) %>
            <% }) %>
        </div>
    <% } else { %>
        <div class="flex flex-col items-center justify-center gap-1 py-10 mt-4 bg-white border border-gray-300 rounded-xl shadow-xl">
            <p class="text-gray-500 text-sm">Lo sentimos...</p>
            <p class="text-gray-700 font-semibold">No hay productos en esta categoria.</p>
        </div>
    <% } %>



    
   
</div>
