<% if (flash) { %>
    <div class="flex justify-center scroll-py-2">
        <div class="cartel-agregado bg-emerald-100 border border-emerald-400 text-emerald-800 px-2 py-4 rounded-xl inline-flex items-center gap-2 font-semibold">
            <%= flash %>
        </div>
    </div>
<% } %>

<section class="bg-[#E5E5E5] py-8 sm:py-10 px-4">
    <div class="flex justify-end">
        <div class="w-24 bg-[#44C79A] rounded-2xl"></div>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-gray-900 flex items-center justify-center text-center">
        Bienvenido a MiEcommerce
    </h1>
    <p class="text-sm sm:text-base text-gray-600 mt-2 mb-6 flex items-center justify-center text-center max-w-2xl mx-auto">
        Explora nuestra amplia selección de productos tecnológicos y encuentra lo que necesitas.
    </p>

    <%- include('../partials/barraDeProductos') %>

    <div class="relative mt-8 sm:mt-10 mb-8 sm:mb-12">
        <div class="bg-[#44C79A] w-full py-8 sm:py-10">
            <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-center items-center gap-6 md:gap-10">
                <%- include('../partials/publicidad') %>
                <%- include('../partials/publicidad') %>
            </div>
        </div>
    </div>

    <section class="section2 mt-10 sm:mt-15">
        <div class="contenedor-verde">
            <div class="w-full max-w-6xl flex items-end">
                <p class="text-black text-xl sm:text-2xl">Te pueden interesar...</p>
            </div>
            <div class="contenedor-tarjetas">
                <% productos.forEach(producto => { %>
                    <%- include('../partials/productCard', { producto: producto }) %>
                <% }) %>
            </div>
            <button class="btn-primario">
                Explorar todos nuestros productos
            </button>
        </div>
    </section>
</section>

<section class="section2 mt-8 sm:mt-15 px-4">
    <div class="contenedor-verde">
        <div class="w-full max-w-6xl flex items-end">
            <p class="text-black text-xl sm:text-2xl">Productos mas pedidos</p>
        </div>
        <div class="contenedor-tarjetas">
            <% productosMasLlevados.forEach(producto => { %>
                <%- include('../partials/productCard', { producto: producto }) %>
            <% }) %>
        </div>

        <button class="btn-primario">
            Explorar los productos mas pedidos
        </button>
    </div>
</section>

<section class="bg-[#E5E5E5] py-8 sm:py-10 px-4">
    <%- include('../partials/barraDeProductos') %>
</section>

