<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'MiEcommerce' %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#E5E5E5] min-h-screen flex flex-col">
    <%- include('../partials/header', { contador: typeof contador !== 'undefined' ? contador : 0 }) %>

    <main class="flex-1">
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <!-- Indicador de conexión WebSocket -->
    <div id="ws-status" style="position:fixed;bottom:12px;right:12px;display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:20px;background:#1e1e1e;color:#fff;font-size:13px;font-family:sans-serif;z-index:9999;opacity:0.85;">
        <span id="ws-dot" style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></span>
        <span id="ws-text">Desconectado</span>
    </div>

    <script>
    (function () {
        const dot  = document.getElementById('ws-dot');
        const text = document.getElementById('ws-text');

        function connect() {
            const ws = new WebSocket('ws://' + location.host);

            ws.onopen = function () {
                dot.style.background  = '#22c55e';
                text.textContent      = 'Conectado';
            };

            ws.onmessage = function (event) {
                var data = JSON.parse(event.data);

                // Actualiza el contador del header
                if (data.type === 'cart-update') {
                    var el = document.getElementById('cart-count');
                    if (el) el.textContent = data.count;
                }

                // Sincroniza la vista del carrito
                if (data.type === 'cart-sync') {
                    var container = document.getElementById('cart-items-container');

                    if (container) {
                        if (!data.items || data.items.length === 0) {
                            container.innerHTML = '<div id="cart-empty-msg" class="my-8 rounded-2xl border border-dashed border-gray-300 bg-white p-6 text-center text-gray-600">Tu carrito está vacío.</div>';
                        } else {
                            var emptyMsg = document.getElementById('cart-empty-msg');
                            if (emptyMsg) emptyMsg.remove();

                            // Eliminar filas de productos que ya no están
                            var rows = container.querySelectorAll('[data-product-id]');
                            rows.forEach(function (row) {
                                var id = Number(row.getAttribute('data-product-id'));
                                var exists = data.items.some(function (item) { return item.id === id; });
                                if (!exists) row.remove();
                            });

                            // Actualizar cantidades y subtotales
                            data.items.forEach(function (item) {
                                var row = container.querySelector('[data-product-id="' + item.id + '"]');
                                if (row) {
                                    var qty = row.querySelector('.cart-item-qty');
                                    var sub = row.querySelector('.cart-item-subtotal');
                                    if (qty) qty.textContent = item.cantidad;
                                    if (sub) sub.textContent = '$ ' + item.subtotal.toLocaleString();
                                }
                            });
                        }
                    }

                    // Actualizar el total general
                    var totalEl = document.getElementById('cart-total');
                    if (totalEl) totalEl.textContent = '$ ' + data.total.toLocaleString();
                }
            };

            ws.onclose = function () {
                dot.style.background  = '#ef4444';
                text.textContent      = 'Desconectado';
                setTimeout(connect, 3000);   // reintenta cada 3s
            };
        }

        connect();
    })();
    </script>
</body>
</html>