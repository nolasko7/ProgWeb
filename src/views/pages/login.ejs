
<div class="bg-[#44C79A] h-78"></div>

<div class="body-class-caja_GU -mt-60 relative z-10 mx-auto">
    <a href="/"><img src="/images/flechaHome.png"></a>

    <h1 class="my-4 text-3xl">¡HOLA!</h1>

    <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="w-full mb-3 bg-emerald-100 border border-emerald-400 text-emerald-800 px-3 py-2 rounded-xl text-sm font-semibold">
            <%= flash %>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="w-full mb-3 text-red-500 text-sm" id="error-login"><%= error %></div>
    <% } %>

    <form action="/login" method="POST" class="flex flex-col items-start w-full">
        <input class="body-class-caja_GU_elemento_a" type="email" name="email" id="email" placeholder="Ingrese su correo electrónico" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
        <input class="body-class-caja_GU_elemento_a" type="password" name="password" id="password" placeholder="Ingrese su contraseña" required>
        <button type="submit" class="my-3 w-full text-gray-50 bg-mist-600 text-center rounded-full py-2 cursor-pointer transition-colors duration-300 hover:bg-mist-900">Iniciar sesión</button>
    </form>
</div>

<p class="text-center mt-10 pb-10">No tienes cuenta?<a class="underline underline-offset-4" href="/register"> Registrate</a></p>
