<div class="mx-4 sm:mx-12 md:mx-32 lg:mx-72 my-6">
    <h1 class="text-4xl mb-6">Mis pedidos</h1>

    <% if (pedidos.length === 0) { %>
        <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-6 text-center text-gray-600" id="sin-pedidos">
            Todavía no hiciste ningún pedido.
            <div class="mt-4"><a href="/" class="btn-primario inline-block">Ver productos</a></div>
        </div>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% pedidos.forEach(pedido => { %>
                <div class="flex justify-between items-center bg-white rounded-2xl px-6 py-4 shadow-[0_4px_10px_rgba(0,0,0,0.10)]">
                    <div>
                        <p class="font-semibold">Pedido #<%= pedido.id %></p>
                        <p class="text-sm text-gray-500"><%= pedido.created_at %> · <%= pedido.cantidad_productos %> producto(s)</p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl">$ <%= Number(pedido.total).toLocaleString() %></p>
                        <p class="text-xs uppercase tracking-wide text-gray-500"><%= pedido.status %></p>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>
