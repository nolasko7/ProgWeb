

<div class = "max-w-6xl mx-auto py-8 px-4">
    <div class="w-full flex justify-center h-32 items-center">
        <h1 class="text-3xl font-medium text-gray-900">Busqueda: <%= busqueda %></h1>
    </div>
    <div class="w-full flex justify-between items-center h-20 px-10">
        <div class="flex items-center">
            <h2 class="text-lg font-semibold text-gray-800">Lista de Productos:</h2>
        </div>
    </div>
    <% if (productos.length > 0) { %>
        <div class="contenedor-tarjetas">
            <% productos.forEach(producto => { %>
                <%- include('../partials/productCard', {producto: producto}) %>
            <% }) %>
        </div>
    <% } else { %>
        <div class="flex flex-col items-center justify-center gap-1 py-10 mt-4 bg-white border border-gray-300 rounded-xl shadow-xl">
            <p class="text-gray-500 text-sm">Lo sentimos...</p>
            <p class="text-gray-700 font-semibold">No se encontraron resultados para "<%= busqueda %>".</p>
        </div>
    <% } %>
</div>