
<div class="flex flex-col my-4 border border-white py-2 rounded-2xl shadow-[0_4px_10px_rgba(0,0,0,0.15)] bg-white shrink-0">

    <div class="flex justify-between items-center">

        <div class="flex order-1 items-center min-w-0 ">
            <img class="shrink-0 p-2 rounded-4xl" src=" <%= elementosCarrito.objeto.image %>" alt="logo" width="90" height="90">
            <p class="flex items-center pl-5 truncate"><%= elementosCarrito.objeto.name  %> </p>
        </div>

        <div class="order-3 flex pr-10 items-center shrink-0 min-w-0">

            <form action="/cart/remove/<%= elementosCarrito.objeto.id %>" method="POST" class="inline">
                <button class="mx-2 bg-gray-500 text-white rounded-2xl px-3 py-1.5 cursor-pointer" type="submit">Quitar</button>
            </form>

            <div class="mx-3 flex items-center border border-black rounded-2xl py-1">
                <form action="/cart/decrement/<%= elementosCarrito.objeto.id %>" method="POST" class="inline">
                    <button class="cursor-pointer mx-2" type="submit">-</button>
                </form>
                <p class="mx-2 "><%= elementosCarrito.cantidad %></p>
                <form action="/cart/increment/<%= elementosCarrito.objeto.id %>" method="POST" class="inline">
                    <button class="cursor-pointer mx-2" type="submit">+</button>
                </form>
            </div>

            <p class="text-3xl shrink-0">$ <%= elementosCarrito.total.toLocaleString() %> </p>

        </div>

    </div>

</div>