<%# Tarjeta chica de producto (productos relacionados / también te puede interesar en la página de producto) %>
<a href="/product/<%= producto.id %>" class="group flex flex-col h-full bg-white border border-gray-200 rounded-2xl p-3 shadow-md hover:shadow-xl transition-all duration-300">
    <div class="aspect-square w-full overflow-hidden rounded-xl bg-gray-50 mb-3">
        <img
            src="<%= producto.images_main || '/images/images.jpg' %>"
            alt="<%= producto.name %>"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            onerror="this.onerror=null;this.src='/images/images.jpg';">
    </div>
    <p class="text-sm font-semibold text-gray-800 leading-snug line-clamp-2 min-h-[2.5rem] group-hover:text-emerald-600">
        <%= producto.name %>
    </p>
    <div class="mt-auto pt-2 flex items-end justify-between gap-2">
        <p>
            <span class="text-lg font-black text-gray-900"><%= producto.price %></span>
            <span class="text-[10px] font-bold text-gray-500 uppercase">puntos</span>
        </p>
        <span class="text-[10px] font-bold uppercase <%= producto.stock > 0 ? 'text-gray-700' : 'text-red-500' %>">
            Stock: <%= producto.stock %>
        </span>
    </div>
</a>
