<%# Tarjeta de producto (home, categorías y búsqueda). Todas las tarjetas miden lo mismo: %>
<%# el nombre ocupa siempre 2 renglones y el botón queda pegado abajo, así los precios quedan alineados. %>
<div class="bg-white border border-gray-200 rounded-2xl p-3 shadow-md hover:shadow-xl transition-all duration-300 h-full flex flex-col">
    <a href="/product/<%= producto.id %>" class="block aspect-square w-full overflow-hidden rounded-xl bg-gray-50 mb-4">
        <img
            src="<%= producto.images_main || '/images/images.jpg' %>"
            alt="<%= producto.name %>"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            loading="lazy"
            onerror="this.onerror=null;this.src='/images/images.jpg';">
    </a>

    <div class="flex flex-col flex-1">
        <span class="text-xs font-semibold text-emerald-600 uppercase mb-1">
            <%= producto.category_name || 'Sin categoría' %>
        </span>
        <a href="/product/<%= producto.id %>" class="font-bold text-gray-800 text-lg leading-snug line-clamp-2 min-h-[3.5rem] hover:text-emerald-600">
            <%= producto.name %>
        </a>
        <p class="mt-2">
            <span class="text-2xl font-black text-gray-900"><%= producto.price %></span>
            <span class="text-sm font-bold text-gray-500 uppercase">puntos</span>
        </p>
        <p class="text-xs font-bold uppercase tracking-wide mb-4 <%= producto.stock > 0 ? 'text-gray-700' : 'text-red-500' %>">
            Stock: <%= producto.stock %>
        </p>

        <div class="mt-auto">
            <% if (producto.stock > 0) { %>
                <form action="/cart/add" method="POST">
                    <input type="hidden" name="productId" value="<%= producto.id %>">
                    <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-2 px-4 rounded-xl transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer">
                        <img src="/images/Carrito.svg" class="h-5 w-5" alt="">
                        <span>Agregar al carrito</span>
                    </button>
                </form>
            <% } else { %>
                <button type="button" disabled class="w-full bg-gray-300 text-gray-600 font-semibold py-2 px-4 rounded-xl flex items-center justify-center gap-2 cursor-not-allowed">
                    <span>Sin stock</span>
                </button>
            <% } %>
        </div>
    </div>
</div>
