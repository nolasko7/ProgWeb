<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#E5E5E5] min-h-screen flex flex-col">

    <%- include('../partials/header') %> 
    
    <main class="page-home flex-1">


        <section class="bg-[#E5E5E5] min-h-screen py-10">
            <h1 class="text-4xl font-bold mb-2 text-gray-900 flex items-center justify-center">
                Bienvenido a MiEcommerce
            </h1>
            <p class="text-gray-600 mt-2 mb-6 flex items-center justify-center">
                Explora nuestra amplia selección de productos tecnológicos y encuentra lo que necesitas.
            </p>

            <%- include(`../partials/barraDeProductos`)%>
        

            <div class="bg-[#44C79A] h-60 w-full mt-10"></div>

            <div class="flex justify-center items-center -mt-50 space-x-10">

                <%- include(`../partials/publicidad`)  %>
                <%- include(`../partials/publicidad`)  %>
                
                
            </div>

            <section class="section2 mt-15">


                <div class="contenedor-verde">
                    <div class="flex items-end"><p class="text-black text-2xl w-6xl">Te pueden interesar...</p></div>
                    <div class="contenedor-tarjetas">
                        <% productosTec.forEach(producto => { %>
                            <%- include('../partials/productCard', { producto: producto }) %>
                        <% }) %>
                    </div>
                    <button class="btn-primario">
                        Explorar todos nuestros productos
                    </button>

                </div>
            </section>
        </section>

        <section class="section2 mt-15">


                <div class="contenedor-verde">
                    <div class="flex items-end"><p class="text-black text-2xl w-6xl">Produtos mas pedidos</p></div>
                    <div class="contenedor-tarjetas">
                        <% productosTec.forEach(producto => { %>
                            <%- include('../partials/productCard', { producto: producto }) %>
                        <% }) %>
                    </div>
                    <button class="btn-primario">
                        Explorar los productos mas pedidos
                    </button>

                </div>
            </section>

        <section class="bg-[#E5E5E5] min-h-screen py-10">

            <%- include(`../partials/barraDeProductos`)%>

        </section>
    </main>
    <%- include('../partials/footer') %>
</body>

</html>