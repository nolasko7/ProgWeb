<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiEcommerce</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body>
    <main class="page-home">
        <section class="bg-[#E5E5E5] h-[100vh]">
            <h1 class="text-4xl font-bold mb-2 text-gray-900 flex items-center justify-center">
                Bienvenido a MiEcommerce
            </h1>
            <p class="text-gray-600 mt-2 mb-6 flex items-center justify-center">
                Explora nuestra amplia selección de productos tecnológicos y encuentra lo que necesitas.
            </p>

            <section class="mt-15 flex flex-row justify-center items-center ">
                <div
                    class="w-32 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Electronica.png" alt="Electronica" class="w-8 h-8 mb-2 object-contain ">
                    <p class="text-white text-sm text-center text-lg font-bold">Electronica</p>
                </div>
                <div
                    class="w-32 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Alimentos.png" alt="Alimentos" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Alimentos</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Bebidas.png" alt="Bebidas" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Bebidas</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Automotor.png" alt="Automotor" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Automotor</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Hogar.png" alt="Hogar" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Hogar</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Indumentaria.png" alt="Indumentaria" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Indumentaria</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Juegos.png" alt="Juegos" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Juegos</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Otros.png" alt="Otros" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Otros</p>
                </div>
            </section>

            <section class="section2 mt-15">
                <div class="contenedor-verde">
                    <div class="contenedor-tarjetas">
                        <% productosTec.forEach(producto=> { %>
                            <div
                                class="bg-black rounded-lg shadow-md p-8 border border-gray-200 flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
                                <div class="bg-checkerboard w-32 h-32 rounded-lg flex items-center justify-center mb-4">
                                    <span class="text-green-400 text-sm">Sin imagen</span>
                                </div>
                                <h3 class="font-semibold text-lg mb-2 text-green-400">
                                    <%= producto.nombre %>
                                </h3>
                                <p class="text-white mb-4">$<%= producto.precio %>
                                </p>
                                <button class="btn-primario">Agregar al carrito</button>
                            </div>
                            <% }) %>
                    </div>
                    <button class="btn-primario">
                        Explorar todos nuestros productos
                    </button>

                </div>
            </section>

            <section class="bg-[#E5E5E5] h-[100vh]">
                <p class="text-gray-600 text-xl mt-10 mb-6 flex pl-20">Te pueden interesar..</p>
                <text class="flex justify-center"> aca irian productos que le pueden interesar al usuario</text>

                <section class="mt-45 flex flex-row justify-center items-center ">
                <div
                    class="w-32 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Electronica.png" alt="Electronica" class="w-8 h-8 mb-2 object-contain ">
                    <p class="text-white text-sm text-center text-lg font-bold">Electronica</p>
                </div>
                <div
                    class="w-32 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Alimentos.png" alt="Alimentos" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Alimentos</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Bebidas.png" alt="Bebidas" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Bebidas</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Automotor.png" alt="Automotor" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Automotor</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Hogar.png" alt="Hogar" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Hogar</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Indumentaria.png" alt="Indumentaria" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Indumentaria</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Juegos.png" alt="Juegos" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Juegos</p>
                </div>
                <div
                    class="w-30 h-20 bg-gray-900 p-2 rounded cursor-pointer transition-colors duration-300 hover:bg-green-400 border-r border-white/70 flex items-center flex-col">
                    <img src="/images/Otros.png" alt="Otros" class="w-8 h-8 mb-2 object-contain">
                    <p class="text-white text-sm text-center text-lg font-bold">Otros</p>
                </div>
            </section>

            </section>

        </section>




    </main>
</body>

</html>