<!DOCTYPE html>

<html lang="es">

<head>

    <title>login</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">

</head>

    <body>

    <header>
        <div class="header-class header-class-texto">
            <h2 ><span class="font-black">Mi</span><span>Ecommerce</span></h2>
        </div>
    </header>

    <main class="body-main-class relative">

        
        <div class="bg-[#44C79A] h-64"></div>

        <div class="body-class-caja_login -mt-40 relative z-10 mx-auto">

            <h1 class="mb-10 text-3xl">¡HOLA!</h1>

            <form action="#" class="flex flex-col items-start w-full">

                <input class="body-class-caja_login_elementos_email_contraseña" type="email" name="Email" id="Email" placeholder="Ingrese su correo electrónico" required>
                <input class="body-class-caja_login_elementos_email_contraseña" type="password" name="password" id="Contraseña" placeholder="Ingrese su contraseña" required>
                <button type="submit" class="my-3 w-full text-gray-50 bg-mist-600 text-center rounded-full py-2">Iniciar sesión</button>

            </form>

        </div>

        <p class="text-center mt-10 pb-10">No tienes cuenta?<a class="underline underline-offset-4"href="register.ejs"> Registrate</a></p>

    </main>

    <footer>

        <img src="img/logo.png" alt="logo" width="50px" height="50px">
        <img src="img/facebook.png" alt="facebook" width="50px" height="50px">
        <img src="img/instagram.png" alt="instagram" width="50px" height="50px">
        <p> © MiEcommerce. Todos los derechos reservados.</p>
        <img src="img/twitter.png" alt="twitter" width="50px" height="50px">
        <p>App store </p>
        <img src="img/linkedin.png" alt="linkedin" width="50px" height="50px">
        <p>Google Play</p>

    </footer>

    </body>

</html>
