<!DOCTYPE html>

<html lang="es">

<head>

    <title>login</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">

</head>

    <body>

    <header>
        
        <h2>MiEcommerce</h2>
    </header>
    
    <main> 
        
        <div class="caja-login">
        <h1>¡HOLA!</h1>

        <form action = "#">

            <label for="Email"> Email</label> <input type="email" name="Email" id="Email" placeholder="Ingrese su correo electrónico" required>
            <label for="Contraseña"> Contraseña</label> <input type="password" name="password" id="Contraseña" placeholder="Ingrese su contraseña" required>
            <button type="submit" class="boton-login">Iniciar sesión</button>

        </form>

        <section> 
            <p>No tienes cuenta?</p> <a href = "register.ejs">Registrate</a> 
        </section>
        </div>

    </main>

    <footer>
        <img src="img/logo.png" alt="logo" width="50px" height="50px">
        <img src="img/facebook.png" alt="facebook" width="50px" height="50px">
        <img src="img/instagram.png" alt="instagram" width="50px"  height="50px">
        <p> © MiEcommerce. Todos los derechos reservados.</p>
        <img src="img/twitter.png" alt="twitter" width="50px" height="50px">
        <p>App store </p>
        <img src="img/linkedin.png" alt="linkedin" width="50px" height="50px">
        <p>Google Play</p>

    </footer>





    </body>



</html>