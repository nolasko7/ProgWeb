<!DOCTYPE html>

<html lang="es">

<head>

    <title>Login</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">

</head>

    <body class="bg-[#F3F1F3] min-h-screen flex flex-col">

    <%- include('../partials/header') %> 



    
    <main class="body-main-class relative flex-1">

        
        <div class="bg-[#44C79A] h-78 "></div>

        <div class="body-class-caja_GU -mt-60 relative z-10 mx-auto">

            <a href="/"><img src="/images/flechaHome.png"> </a><!-- Boton de para ir al inicio-->

            <h1 class="my-4 text-3xl">¡HOLA!</h1>

            <form action="/login" class="flex flex-col items-start w-full">

                <input class="body-class-caja_GU_elemento_a" type="email" name="Email" id="Email" placeholder="Ingrese su correo electrónico" required>
                <input class="body-class-caja_GU_elemento_a" type="password" name="password" id="Contraseña" placeholder="Ingrese su contraseña" required>
                <button type="submit" class="my-3 w-full text-gray-50 bg-mist-600 text-center rounded-full py-2">Iniciar sesión</button>

            </form>

        </div>

        <p class="text-center mt-10  pb-10">No tienes cuenta?<a class="underline underline-offset-4"href="register"> Registrate</a></p>
        
    </main>
    <%- include('../partials/footer') %>
    </body>

</html>
