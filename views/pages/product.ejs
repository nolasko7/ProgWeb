<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiEcommerce - Producto</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-200 min-h-screen">
    <%- include('../partials/header') %>
        <div class="max-w-6xl mx-auto px-4 py-8">
            <nav aria-label="breadcrumb" class="text-sm text-gray-700 mb-4 flex items-center gap-1 font-medium">
                <a href="/" class="text-gray-700 no-underline hover:underline flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                        stroke-width="2.5" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    Volver al listado
                </a>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    stroke-width="2.5" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
                <a href="/category/<%=product.category %>"
                    class="text-gray-700 no-underline hover:underline flex items-center gap-1">
                    <span>
                        <%=product.category %>
                    </span>
                </a>

            </nav>
            <div class="w-full flex flex-col md:flex-row gap-8 p-2 border border-gray-300 rounded-xl overflow-hidden bg-white shadow-xl">
                <h1 class="text-3xl font-medium mb-2 text-gray-900 md:hidden px-2 pt-2">
                    <%= product.name%>
                </h1>
                <div class="w-full md:w-3/5 flex flex-col-reverse md:flex-row gap-4 p-0">
                    <div class="flex flex-row md:flex-col gap-2">
                        <img src="https://placehold.co/100x100" alt="Vista 1 de <%= product.name %>"
                            class="w-14 h-14 object-cover rounded-lg">
                        <img src="https://placehold.co/100x100" alt="Vista 2 de <%= product.name %>"
                            class="w-14 h-14 object-cover rounded-lg">
                        <img src="https://placehold.co/100x100" alt="Vista 3 de <%= product.name %>"
                            class="w-14 h-14 object-cover rounded-lg">
                    </div>
                    <img src="<%= product.image %>" alt="<%= product.name %>"
                        class="w-full h-64 md:w-auto md:h-full md:flex-1 object-cover rounded-lg">
                </div>
                <div class="w-full md:w-2/5 p-6 md:border md:border-gray-300 md:rounded-xl md:shadow-md flex flex-col">
                    <h1 class="text-3xl font-medium mb-2 text-gray-900 order-1 hidden md:block">
                        <%= product.name%>
                    </h1>
                    <p class="mb-4 order-2">
                        <span class="text-5xl font-bold text-gray-900">
                            <%= product.price.toLocaleString('es-AR') %>
                        </span>
                        <span class="text-2xl font-semibold text-gray-500 uppercase tracking-wide">
                            <%= "Puntos" %>
                        </span>
                    </p>
                    <button type="button"
                        class="w-full bg-gray-600 text-white font-semibold px-6 py-3 rounded-full hover:bg-gray-700 cursor-pointer order-4 md:order-3">Agregar
                        al carrito </button>
                    <p class="text-gray-800 mb-6 whitespace-pre-line order-3 md:order-4">
                        <%= product.description %>
                    </p>
                </div>
            </div>
            <h2 class="text-2xl mt-8">Tambien te puede interesar</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2 mt-4">
                <div class="flex md:block gap-3 border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                    <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8"
                        class="w-20 h-20 flex-shrink-0 rounded-lg object-cover md:w-full md:h-68 md:rounded-none">
                    <div class="flex flex-col md:flex-row md:justify-between gap-1 md:gap-2 md:mt-2">
                        <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                        <p class="text-sm leading-tight md:border-l md:border-gray-200 md:pl-2 md:w-55">
                            <span class="font-semibold text-gray-900">760</span>
                            <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                        </p>
                    </div>
                </div>
                <div class="flex md:block gap-3 border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                    <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8"
                        class="w-20 h-20 flex-shrink-0 rounded-lg object-cover md:w-full md:h-68 md:rounded-none">
                    <div class="flex flex-col md:flex-row md:justify-between gap-1 md:gap-2 md:mt-2">
                        <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                        <p class="text-sm leading-tight md:border-l md:border-gray-200 md:pl-2 md:w-55">
                            <span class="font-semibold text-gray-900">760</span>
                            <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                        </p>
                    </div>
                </div>
                <div class="hidden md:block gap-3 border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                    <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8"
                        class="w-20 h-20 flex-shrink-0 rounded-lg object-cover md:w-full md:h-68 md:rounded-none">
                    <div class="flex flex-col md:flex-row md:justify-between gap-1 md:gap-2 md:mt-2">
                        <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                        <p class="text-sm leading-tight md:border-l md:border-gray-200 md:pl-2 md:w-55">
                            <span class="font-semibold text-gray-900">760</span>
                            <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                        </p>
                    </div>
                </div>
                <div class="hidden md:block gap-3 border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                    <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8"
                        class="w-20 h-20 flex-shrink-0 rounded-lg object-cover md:w-full md:h-68 md:rounded-none">
                    <div class="flex flex-col md:flex-row md:justify-between gap-1 md:gap-2 md:mt-2">
                        <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                        <p class="text-sm leading-tight md:border-l md:border-gray-200 md:pl-2 md:w-55">
                            <span class="font-semibold text-gray-900">760</span>
                            <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="flex w-full overflow-x-auto md:w-fit md:overflow-hidden items-center mt-10 mx-auto px-2 bg-gray-900 border border-gray-300 rounded-4xl shadow-md hover:shadow-xl transition-all duration-300 h-full">
                <section class="flex flex-row flex-nowrap justify-center items-center ">
                    <% categories.forEach(category=> { %>
                        <a href="/category/<%= category.name %>">
                            <div
                                class="w-32 h-20 bg-gray-900 p-1 cursor-pointer transition-colors duration-300 hover:bg-green-400 flex items-center flex-col">
                                <img src="<%= category.photo %>" alt="<%= category.name %>"
                                    class="w-8 h-8 mt-2 mb-1 object-contain ">
                                <p class="text-white text-sm text-center text-lg font-bold">
                                    <%= category.name %>
                                </p>
                            </div>
                        </a>
                        <% }) %>
                </section>
            </div>
        </div>
        <%- include('../partials/footer') %>
</body>

</html>