<!DOCTYPE html>
<html lang = "es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>MiEcommerce - Producto</title>
        <link rel="stylesheet" href="/css/output.css">
    </head>
    <body class="bg-gray-200 min-h-screen">
        <div class="max-w-6xl mx-auto px-4 py-8">
          <nav aria-label="breadcrumb" class="text-sm text-gray-700 mb-4 flex items-center gap-1 font-medium">
              <a href="/" class="text-gray-700 no-underline hover:underline flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                Volver al listado
               </a>
               <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                   stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
               </svg>
               <span><%=product.category %></span>

          </nav>
          <div class = "flex gap-8 p-2 border border-gray-300 rounded-xl overflow-hidden bg-white shadow-xl"> 
            <div class="w-3/5 flex gap-4 p-0">
               <div class="flex flex-col gap-2">
                    <img src="https://placehold.co/100x100" alt="Vista 1 de <%= product.name %>" class="w-14 h-14 object-cover rounded-lg">
                    <img src="https://placehold.co/100x100" alt="Vista 2 de <%= product.name %>" class="w-14 h-14 object-cover rounded-lg">
                    <img src="https://placehold.co/100x100" alt="Vista 3 de <%= product.name %>" class="w-14 h-14 object-cover rounded-lg">
                </div>
                <img src="<%= product.image %>" alt="<%= product.name %>" class="flex-1 object-cover rounded-lg h-full">
            </div>
            <div class="w-2/5 p-6 border border-gray-300 rounded-xl shadow-md">
              <h1 class="text-3xl font-medium mb-2 text-gray-900"><%= product.name%></h1>
              <p class="mb-4">
                <span class="text-5xl font-bold text-gray-900"><%= product.price.toLocaleString('es-AR') %></span>
                <span class="text-2xl font-semibold text-gray-500 uppercase tracking-wide"><%= "Puntos" %></span>
              </p>
              <button type = "button" class="w-full bg-gray-600 text-white font-semibold px-6 py-3 rounded-full hover:bg-gray-700">Agregar al carrito </button>
              <p class="text-gray-800 mb-6 whitespace-pre-line "><%= product.description %></p>
            </div>
          </div>
         <h2 class="text-2xl mt-8">Tambien te puede interesar</h2>
          <div class="grid grid-cols-4 gap-2 mt-4"> 
             <div class="border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                 <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8" class="w-full h-68 object-cover">
                  <div class="flex justify-between gap-2 mt-2"> 
                     <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                     <p class="text-sm border-l border-gray-200 pl-2 leading-tight w-55">
                         <span class="font-semibold text-gray-900">760</span> 
                         <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                     </p>
                  </div> 
             </div> 
             <div class="border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                 <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8" class="w-full h-68 object-cover">
                  <div class="flex justify-between gap-2 mt-2"> 
                     <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                     <p class="text-sm border-l border-gray-200 pl-2 leading-tight w-55">
                         <span class="font-semibold text-gray-900">760</span> 
                         <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                     </p>
                  </div> 
             </div>
             <div class="border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                 <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8" class="w-full h-68 object-cover">
                  <div class="flex justify-between gap-2 mt-2"> 
                     <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                     <p class="text-sm border-l border-gray-200 pl-2 leading-tight w-55">
                         <span class="font-semibold text-gray-900">760</span> 
                         <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                     </p>
                  </div> 
             </div>
             <div class="border border-gray-300 rounded-xl p-3 bg-white shadow-xl">
                 <img src="https://placehold.co/300x300" alt="Coca Cola Lata 220mL Pack Original x8" class="w-full h-68 object-cover">
                  <div class="flex justify-between gap-2 mt-2"> 
                     <p class="text-sm font-semibold text-gray-900 ">Coca Cola Lata 220mL Pack Original x8</p>
                     <p class="text-sm border-l border-gray-200 pl-2 leading-tight w-55">
                         <span class="font-semibold text-gray-900">760</span> 
                         <span class="block text-[7px] text-gray-500 uppercase">Puntos</span>
                     </p>
                  </div> 
             </div>
           </div>
        </div>
    </body>
</html>