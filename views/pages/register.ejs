<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
  <%- include('../partials/header') %>
  <section class="register-module">
    
  <h1>MiEcommerce</h1>  
  <h2>¡Registrateee!</h2>

  <form action="/register" method="GET">
    <p>
      <label for="name">Nombre</label>
      <input 
        type="text" 
        id="name"
        name="name" 
        placeholder="Tu nombre gato" 
        required 
      />
    </p>

    <p>
      <label for="email">Email</label>
      <input 
        type="email" 
        id="email"
        name="email" 
        placeholder="Tu email(acordate del @ gil)" 
        required 
      />
    </p>

    <p>
      <label for="password">Contraseña</label>
      <input 
        type="password" 
        id="password"
        name="password" 
        placeholder="Tu nueva contraseña" 
        required 
      />
    </p>

    <button type="submit">Registrarse</button>
  </form>
  <p class="login-link">
    ¿Tenes una cuenta existente? <a href="/login">Inicia Sesión</a>
  </p>

  </section>
  <%- include('../partials/footer') %>
</body>
</html>

