<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#F3F1F3] min-h-screen flex flex-col">
  <%- include('../partials/header') %>
  <main class="body-main-class relative flex-1">

        
        <div class="bg-[#44C79A] h-64 "></div>

        <div class="body-class-caja_register -mt-40 relative z-10 mx-auto">

            <h1 class="mb-10 text-3xl">¡Bienvenido!</h1>

            <form action="/register" method="GET" class="flex flex-col items-start w-full">
                <input class="body-class-caja_register_elemento_a" type="text" name="Nombre" id="Nombre" placeholder="Ingrese su nombre" required>
                <input class="body-class-caja_register_elemento_a" type="email" name="Email" id="Email" placeholder="Ingresa tu email" required>
                <input class="body-class-caja_register_elemento_a" type="password" name="password" id="Contraseña" placeholder="Ingresa tu contraseña" required>
                <button type="submit" class="my-3 w-full text-gray-50 bg-mist-600 text-center rounded-full py-2 cursor-pointer ">Registrarse</button>

            </form>

        </div>

        <p class="text-center mt-10  pb-10">¿Tenes una cuenta existente?<a class="underline underline-offset-4"href="/login"> Inicia Sesión</a></p>
        
    </main>

    <%- include('../partials/footer') %>
</body>

</html>

