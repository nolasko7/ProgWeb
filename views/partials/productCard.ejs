<div class="bg-white border border-gray-300 rounded-2xl p-3 shadow-md hover:shadow-xl transition-all duration-300 h-full">
    <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-gray-50 border-4 border-white shadow-md mb-4 group">
        <img 
            src="/images/images.jpg" 
            alt="<%= producto.nombre %>" 
            class="w-full h-full object-cover" 
        >
    </div>
    <div class="flex flex-col">
        <span class="text-xs font-semibold text-emerald-500 uppercase mb-1">Tecnología</span>
        <h3 class="font-bold text-gray-800 text-lg mb-2">
            <%= producto.nombre %>
        </h3>
        <p class="text-2xl font-black text-gray-900">
            <%= producto.precio %>
        </p>
        <p class="text-sm font-black text-gray-500 mb-4">Puntos</p>
    </div>
    <button 
        class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-2 px-4 rounded-xl transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
    >
        <img src="/images/Carrito.svg" class="h-5 w-5" alt="Carrito">
        <span>Agregar al carrito</span>
    </button>
</div>